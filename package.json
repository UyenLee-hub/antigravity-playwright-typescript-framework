{
  "name": "playwright-typescript-framework",
  "version": "1.0.0",
  "description": "Enterprise-ready E2E Web UI Automation Framework with Playwright Test, TypeScript Strict Mode, and Allure Report",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:failed": "playwright test --last-failed",
    "allure:generate": "node ./scripts/allure-runner.js generate ./allure-results --clean -o ./allure-report",
    "allure:single": "node ./scripts/allure-runner.js generate ./allure-results --clean --single-file -o ./allure-report",
    "allure:open": "node ./scripts/allure-runner.js open ./allure-report",
    "allure:serve": "node ./scripts/allure-runner.js serve ./allure-results",
    "allure:clean": "rimraf ./allure-results ./allure-report test-results playwright-report",
    "report": "npm run allure:generate && npm run allure:open"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "e2e",
    "allure-report",
    "testing"
  ],
  "author": "Antigravity QA Automation Architect",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.17.0",
    "allure-commandline": "^2.32.0",
    "allure-js-commons": "^3.0.7",
    "allure-playwright": "^3.0.7",
    "dotenv": "^16.4.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}
